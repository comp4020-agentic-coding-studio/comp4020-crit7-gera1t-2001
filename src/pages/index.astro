---
import { listBookings } from "../lib/db";
import { ROOMS, SLOTS } from "../lib/options";
import "../styles.css";

const bookings = listBookings();
const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "taken"
    ? "That slot is already booked"
    : error === "invalid"
      ? "Please check the form and try again"
      : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Room Booking</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Bookings</h1>
      {errorMessage && <p role="alert">{errorMessage}</p>}
      <form method="post" action="/api/bookings">
        <label for="room">Room</label>
        <select id="room" name="room" required>
          {ROOMS.map((room) => <option value={room}>{room}</option>)}
        </select>

        <label for="date">Date</label>
        <input id="date" name="date" type="date" required />

        <label for="slot">Time</label>
        <select id="slot" name="slot" required>
          {SLOTS.map((slot) => <option value={slot}>{slot}</option>)}
        </select>

        <label for="name">Name</label>
        <input id="name" name="name" required maxlength="60" />

        <button>Book</button>
      </form>
      <ul id="bookings">
        {
          bookings.map((booking) => (
            <li>
              {booking.room} · {booking.date} {booking.slot} · {booking.name}
            </li>
          ))
        }
      </ul>
    </main>
    <script>
      // The live half of the demo: subscribe to the SSE stream and prepend
      // bookings as they arrive. The form itself needs none of this — its
      // POST + redirect re-renders the submitting tab from SQLite; this
      // stream is how every other tab finds out.
      const list = document.querySelector("#bookings");
      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const booking = JSON.parse(event.data);
        const item = document.createElement("li");
        item.textContent = `${booking.room} · ${booking.date} ${booking.slot} · ${booking.name}`;
        list?.prepend(item);
      });
    </script>
  </body>
</html>
